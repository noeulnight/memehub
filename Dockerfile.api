FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download
COPY apps/api/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/migrate-media ./cmd/migrate-media

FROM alpine:3.23
RUN apk add --no-cache ca-certificates libwebp-tools ffmpeg \
    && adduser -D -H -u 10001 memehub
WORKDIR /app
COPY --from=build /out/api /out/migrate /out/migrate-media /usr/local/bin/
USER memehub
ENV HTTP_ADDR=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api"]
