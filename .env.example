# Configuration example. Set private values in an ignored environment file.
# Local demo: pnpm dev:demo (no OIDC/S3/OpenAI credentials required).
# Alternatively set DEMO_MODE=true below and use pnpm dev after DB migration.
# Demo login uses a shared administrator. Never expose it publicly.
# Demo stores images in ./data (repository root with pnpm dev:demo); AI analysis is disabled.
DEMO_MODE=false
# Optional local demo storage directory, relative to the API working directory.
# With pnpm dev:demo, override via the shell: DEMO_DATA_DIR=/absolute/path pnpm dev:demo

# Public Astro build values and development proxy target
PUBLIC_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# Server-only API address used for SEO rendering.
API_INTERNAL_BASE_URL=http://127.0.0.1:8080/api

# Go API
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
APP_BASE_URL=http://localhost:4321
DATABASE_URL=postgres://memehub:change-me@localhost:5432/memehub?sslmode=disable

# S3-compatible storage. Allow anonymous GetObject for originals/*, thumbnails/*, previews/* only.
# Keep staging/*, bucket listing, and writes private. Public URLs use S3_PRESIGN_ENDPOINT.
# Bucket CORS must allow APP_BASE_URL, PUT/GET, and signed upload headers.
# Use a staging/ lifecycle expiration rule to remove abandoned or replayed uploads.
S3_ENDPOINT=http://localhost:9000
S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=memehub
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# OIDC. Enter values issued by your provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:4321/api/auth/callback
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# OpenAI. Enter an API key and an available model that supports image input.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=2

# Content limits. Proposed starting values pending operating policy decisions.
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,audio/mpeg,audio/wav,audio/ogg,audio/mp4
TEXT_MAX_LENGTH=10000
DELETED_IMAGE_RETENTION_DAYS=7
INCOMPLETE_UPLOAD_RETENTION_HOURS=24

# Requires pgvector in PostgreSQL. Uses text-embedding-3-large (3072 dimensions).
VECTOR_SEARCH_ENABLED=false
